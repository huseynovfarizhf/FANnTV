# Copy to /etc/fanntv/fanntv.env; root-owned mode 0600. Replace examples securely.
# This file is systemd EnvironmentFile format, not application-loaded .env.
FANNTV_ENV=production
FANNTV_DB=/var/lib/fanntv/fanntv.db
PUBLIC_URL=https://tv.example.az
FANNTV_TRUSTED_PROXIES=127.0.0.1,::1
FANNTV_SMTP_HOST=smtp.example.az
FANNTV_SMTP_PORT=587
FANNTV_SMTP_MODE=starttls
FANNTV_SMTP_FROM=noreply@example.az
# FANNTV_SMTP_USERNAME=
# FANNTV_SMTP_PASSWORD=
# Configure a real acquiring bank adapter before taking payments.
# FANNTV_BANK_ADAPTER_URL=https://your-trusted-adapter.example/checkout
# FANNTV_BANK_ADAPTER_KEY=
# FANNTV_PAYMENT_WEBHOOK_SECRET=
# Configure your licensed provider's signed playback adapter before external playback.
# FANNTV_PLAYBACK_ADAPTER_URL=https://your-trusted-adapter.example/playback
# FANNTV_PLAYBACK_ADAPTER_KEY=
