# Documentation only. Set these in secure runtime configuration; this file is not loaded.
# PUBLIC_URL=https://your-app.example
# FANNTV_BANK_ADAPTER_URL=https://your-adapter.example/checkout
# FANNTV_BANK_ADAPTER_KEY=
# FANNTV_PAYMENT_WEBHOOK_SECRET=
# FANNTV_DB=/persistent/path/fanntv.db
# Optional alternative for an eligible Stripe merchant; bank adapter takes precedence.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Production mode is for Gunicorn/WSGI on Linux. See deploy/production.env.example.
# FANNTV_ENV=production
# FANNTV_TRUSTED_PROXIES=127.0.0.1,::1
# FANNTV_SMTP_HOST=smtp.example.az
# FANNTV_SMTP_PORT=587
# FANNTV_SMTP_MODE=starttls
# FANNTV_SMTP_FROM=noreply@example.az
# FANNTV_SMTP_USERNAME=
# FANNTV_SMTP_PASSWORD=
# FANNTV_PLAYBACK_ADAPTER_URL=https://your-adapter.example/playback
# FANNTV_PLAYBACK_ADAPTER_KEY=
